# ============================================================================
# Masingar - production environment (recipe for a small private team, ~5 users
# ============================================================================
# Copy to deploy/.env (docker compose) or export in server/.env (systemd).
# Everything below is FREE: no paid service is required at this scale.

# ------------------------------------------------------------------- core ---
# Public address of this server (https REQUIRED - the apps refuse plain http)
PUBLIC_URL=https://chatmassage.bonto.run
NODE_ENV=production
PORT=3000

# Optional: openssl rand -hex 48
# Without it the server generates one and keeps it in data/.jwt-secret, so
# sessions already survive restarts. Set it explicitly on multi-node setups.
JWT_SECRET=

# Default dialing prefix of your main user base (967 = Yemen)
DEFAULT_COUNTRY_CODE=967

# ------------------------------------------------------------- login codes --
# How verification codes (OTP) reach users. FREE options for a private team:
#
#   ★ telegram (RECOMMENDED - official Bot API, free, no credits, no SMS):
#       1. create the bot once: open @BotFather in Telegram -> /newbot -> copy
#          the token into TELEGRAM_BOT_TOKEN (and TELEGRAM_BOT_USERNAME so the
#          apps can show the bot name).
#       2. every user opens the bot ONCE, presses Start and sends his phone
#          number -> all future verification codes arrive there instantly.
#       The link is stored in the database and survives restarts.
#       The SMS providers below stay as automatic fallbacks if configured.
#
#   console -> code printed in the SERVER LOG; the admin reads it and tells the
#              user. Perfect for ~5 people: one login, session lasts 90 days.
#   textbee -> real SMS, free, sent FROM YOUR OWN Android phone/SIM via the
#              TextBee app (https://textbee.dev). Get an API key there and fill:
SMS_PROVIDER=telegram
# Bot token from @BotFather (example: 1234567890:AAH...). REQUIRED for real sends.
TELEGRAM_BOT_TOKEN=
# Public bot username WITHOUT the leading @ (example: masingar_otp_bot)
TELEGRAM_BOT_USERNAME=
# Text of the OTP message. ${code} is replaced by the 6-digit code.
TELEGRAM_OTP_TEXT=🔐 ماسنجر — كود التحقق هو ${code} — صالح 5 دقائق
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
#SMS_TEXT=ماسنجر: كود التحقق هو ${code}
# paid later, when the team grows: SMS_PROVIDER=twilio + TWILIO_* below
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# ------------------------------------------------------------- calls (free) --
# Nothing to do: with no TURN_SECRET the server automatically hands clients
# STUN (Google) + a free community TURN relay, so calls work behind 4G NATs.
# For full control later, run deploy/coturn on a VPS and set:
TURN_SECRET=
TURN_HOST=
#TURN_PORT=3478
#TURN_TLS_PORT=5349
#TURN_TCP_PORT=443
# FREE_TURN=false   # disable the community relay once coturn is live

# ------------------------------------------------- push (optional but good) --
# Free Firebase Cloud Messaging: wakes the phone for incoming calls when the
# app is closed. Steps in docs/FIREBASE_SETUP.md (5 minutes, no cost).
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=

# ------------------------------------------------------------------ uploads --
#MAX_UPLOAD_MB=25
