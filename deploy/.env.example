# ماسنجر لايت — متغيرات البيئة (انسخها إلى deploy/.env أو اضبطها مباشرة)

# اسم الدائرة (يظهر في شاشة الدخول)
APP_NAME=ماسنجر لايت

# عدد الأعضاء الأقصى — التطبيق مصمم لدائرة صغيرة
MAX_MEMBERS=5

# رمز انضمام اختياري: إذا ضُبط فلن يستطيع أحد التسجيل إلا من يعرفه.
# موصى به عند نشر التطبيق على إنترنت عام (لأن كود التحقق يظهر داخل التطبيق).
JOIN_CODE=

# المنفذ
PORT=3000

# أرشفة صغيرة تلقائية (آخر N عنصر يُحفظ)
MAX_MESSAGES=1000
MAX_POSTS=200

# الفاصل بين طلبات كود التحقق لنفس الرقم (ملي ثانية)
CODE_RESEND_MS=25000
