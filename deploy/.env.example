# Copy to deploy/.env (docker compose) or server/.env (systemd) and fill in.

# ------------------------------------------------------------------ server ---
PUBLIC_URL=https://chat.example.com
DEFAULT_COUNTRY_CODE=967
# openssl rand -hex 48
JWT_SECRET=

# SMS: none | console | twilio | http
SMS_PROVIDER=console
SMS_HTTP_URL=
SMS_HTTP_TOKEN=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=

# -------------------------------------------------------------------- TURN ---
# The same secret must be in deploy/coturn/turnserver.conf
TURN_SECRET=
TURN_HOST=turn.example.com
TURN_REALM=masingar
TURN_PORT=3478
TURN_TLS_PORT=5349
TURN_TCP_PORT=443

# ------------------------------------------------------------------- push ----
FCM_PROJECT_ID=
FCM_CLIENT_EMAIL=
FCM_PRIVATE_KEY=
