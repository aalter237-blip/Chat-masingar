# إعدادات السيرفر واستضافة WispByte / Pterodactyl
# ملاحظة: في لوحة WispByte يتم تعيين SERVER_PORT أو PORT تلقائياً
PORT=3000
SERVER_PORT=
HOST=0.0.0.0
SERVER_IP=
NODE_ENV=production
APP_NAME=ماسنجر لايت
# MAX_MEMBERS: اتركه فارغاً ليكون غير محدود (افتراضي)
MAX_MEMBERS=
DATA_DIR=
WEB_DIR=

# Retention & Limits (سجل الرسائل والمنشورات وحجم الصور)
MAX_MESSAGES=1000
MAX_POSTS=200
MAX_PHOTO_KB=300

# Optional Supabase Cloud Backup (اختياري للنسخ الاحتياطي السحابي)
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

