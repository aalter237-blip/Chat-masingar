# انسخ هذا الملف إلى android/local.properties وعدّل القيم.
# local.properties لا يُرفع إلى Git (انظر .gitignore).

# عنوان سيرفر ماسنجر لايت الذي يفتح عليه التطبيق.
# الافتراضي (بدون هذا الملف) هو النطاق الرسمي: https://shargawe237.com
# ويمكن تغيير العنوان لاحقاً من داخل التطبيق نفسه (نافذة عنوان السيرفر).
# للتجربة على جهاز افتراضي: http://10.0.2.2:3000  (سيرفر يعمل على جهازك)
SERVER_URL=https://shargawe237.com

